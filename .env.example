NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=https://opencode.example.com
DATABASE_PATH=/var/lib/aialra-opencode/control-plane.sqlite
DATABASE_KEY_FILE=/run/credentials/aialra-opencode-control-plane.service/database_key
SESSION_KEY_FILE=/run/credentials/aialra-opencode-control-plane.service/session_key
GRANT_SIGNING_PRIVATE_KEY_FILE=/run/credentials/aialra-opencode-control-plane.service/grant_signing_key
OIDC_ISSUER=https://auth.example.com/application/o/aialra-opencode/
OIDC_CLIENT_ID=replace-with-main-client-id
OIDC_CLIENT_SECRET_FILE=/run/credentials/aialra-opencode-control-plane.service/oidc_client_secret
OIDC_REDIRECT_URI=https://opencode.example.com/auth/callback
OIDC_OWNER_GROUP=aialra-opencode-owner
WEB_DIST_PATH=/opt/aialra-opencode/current/web
TRUST_PROXY=1
DEV_AUTH_BYPASS=0
